rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Entity validator: User
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'photoURL', 'bio', 'position', 'stats'])
        && data.keys().size() == 6
        && data.uid == request.auth.uid // Identity bounds
        && data.displayName is string && data.displayName.size() <= 100
        && data.photoURL is string && data.photoURL.size() <= 2000
        && data.bio is string && data.bio.size() <= 1000
        && data.position in ['Striker', 'Midfielder', 'Defender', 'Goalkeeper', 'Unassigned']
        && data.stats is map
        && data.stats.keys().hasAll(['level', 'matchesPlayed', 'goals', 'mvpCount', 'reliabilityScore'])
        && data.stats.level is number
        && data.stats.matchesPlayed is number
        && data.stats.goals is number
        && data.stats.mvpCount is number
        && data.stats.reliabilityScore is number;
    }

    match /users/{userId} {
      allow read: if isSignedIn(); 

      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUser(incoming());

      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasAny(['bio', 'position', 'photoURL', 'stats', 'displayName'])
        && incoming().diff(existing()).affectedKeys().hasOnly(['bio', 'position', 'photoURL', 'stats', 'displayName'])
        && isValidUser(incoming())
        && incoming().uid == existing().uid;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /presence/{sessionId} {
      allow read, write: if true;
    }
    match /user_bingos/{bingoId} {
      allow read, write: if isSignedIn() && request.auth.uid == bingoId;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId; // Allow users to update their own leaderboard score (normally this is backend only, but we'll allow it for this demo)
    }
  }
}

